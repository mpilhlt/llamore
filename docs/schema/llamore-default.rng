<?xml version="1.0" encoding="UTF-8"?>
<!--
  LLamore default schema

  Validates the TEI documents produced by LLamore: an optional teiHeader
  describing the source document and the extraction run, and the extracted
  references as <biblStruct> elements in a <listBibl> (inside <standOff>, or
  directly below <TEI> as written by llamore.References.to_xml()).

  Hand-written; not generated from an ODD. It only defines elements that
  LLamore output actually contains.

  - The teiHeader part is taken over from the GROBID training schema of the
    FOSSIL project (https://mpilhlt.github.io/fossil/schema/grobid.training.references.rng,
    modules schema/shared/tei-header.rng, bibl-struct.rng, common-elements.rng).
  - The biblStruct part provides the structured equivalents of the flat
    <bibl> content defined by that schema (titles, persons, imprint, scopes,
    cited ranges, identifiers, legal authorities, anaphoric references).

  Published at https://mpilhlt.github.io/llamore/schema/llamore-default.rng
-->
<grammar xmlns="http://relaxng.org/ns/structure/1.0"
  xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0"
  ns="http://www.tei-c.org/ns/1.0"
  datatypeLibrary="http://www.w3.org/2001/XMLSchema-datatypes">

  <start>
    <ref name="TEI"/>
  </start>

  <define name="TEI">
    <element name="TEI">
      <optional>
        <ref name="teiHeader"/>
      </optional>
      <zeroOrMore>
        <choice>
          <ref name="standOff"/>
          <ref name="listBibl"/>
        </choice>
      </zeroOrMore>
    </element>
  </define>

  <define name="att.xmlid">
    <optional>
      <attribute name="id" ns="http://www.w3.org/XML/1998/namespace"/>
    </optional>
  </define>

  <!-- ============================================================ -->
  <!-- teiHeader (from the FOSSIL GROBID training schema)           -->
  <!-- ============================================================ -->

  <define name="teiHeader">
    <element name="teiHeader">
      <a:documentation>Metadata about the source document and the extraction.</a:documentation>
      <zeroOrMore>
        <choice>
          <ref name="fileDesc"/>
          <ref name="encodingDesc"/>
          <ref name="profileDesc"/>
          <ref name="revisionDesc"/>
        </choice>
      </zeroOrMore>
    </element>
  </define>

  <define name="fileDesc">
    <element name="fileDesc">
      <ref name="att.xmlid"/>
      <zeroOrMore>
        <choice>
          <ref name="titleStmt"/>
          <ref name="editionStmt"/>
          <ref name="publicationStmt"/>
          <ref name="sourceDesc"/>
        </choice>
      </zeroOrMore>
    </element>
  </define>

  <define name="titleStmt">
    <element name="titleStmt">
      <zeroOrMore>
        <choice>
          <ref name="title"/>
          <ref name="author"/>
          <ref name="respStmt"/>
        </choice>
      </zeroOrMore>
    </element>
  </define>

  <define name="respStmt">
    <element name="respStmt">
      <zeroOrMore>
        <choice>
          <ref name="persName"/>
          <element name="resp"><text/></element>
        </choice>
      </zeroOrMore>
    </element>
  </define>

  <define name="editionStmt">
    <element name="editionStmt">
      <zeroOrMore>
        <ref name="edition"/>
      </zeroOrMore>
    </element>
  </define>

  <define name="publicationStmt">
    <element name="publicationStmt">
      <zeroOrMore>
        <choice>
          <ref name="publisher"/>
          <ref name="availability"/>
          <ref name="date"/>
          <ref name="idno"/>
          <ref name="ptr"/>
        </choice>
      </zeroOrMore>
    </element>
  </define>

  <define name="availability">
    <element name="availability">
      <optional>
        <attribute name="status"/>
      </optional>
      <interleave>
        <text/>
        <zeroOrMore>
          <ref name="licence"/>
        </zeroOrMore>
      </interleave>
    </element>
  </define>

  <define name="licence">
    <element name="licence">
      <optional>
        <attribute name="target"/>
      </optional>
      <empty/>
    </element>
  </define>

  <define name="sourceDesc">
    <element name="sourceDesc">
      <zeroOrMore>
        <choice>
          <element name="bibl">
            <a:documentation>Unstructured citation of the source document.</a:documentation>
            <text/>
          </element>
          <ref name="biblStruct"/>
          <ref name="licence"/>
          <ref name="ptr"/>
        </choice>
      </zeroOrMore>
    </element>
  </define>

  <define name="encodingDesc">
    <element name="encodingDesc">
      <optional>
        <ref name="editorialDecl"/>
      </optional>
      <zeroOrMore>
        <ref name="appInfo"/>
      </zeroOrMore>
    </element>
  </define>

  <define name="editorialDecl">
    <element name="editorialDecl">
      <oneOrMore>
        <element name="interpretation">
          <optional>
            <attribute name="type"/>
          </optional>
          <optional>
            <attribute name="n"/>
          </optional>
          <element name="p">
            <ref name="ref"/>
            <optional>
              <ref name="ref"/>
            </optional>
          </element>
        </element>
      </oneOrMore>
    </element>
  </define>

  <define name="appInfo">
    <element name="appInfo">
      <zeroOrMore>
        <ref name="application"/>
      </zeroOrMore>
    </element>
  </define>

  <define name="application">
    <element name="application">
      <optional>
        <attribute name="ident"/>
      </optional>
      <optional>
        <attribute name="type"/>
      </optional>
      <optional>
        <attribute name="version"/>
      </optional>
      <optional>
        <attribute name="when"/>
      </optional>
      <zeroOrMore>
        <choice>
          <element name="label">
            <optional>
              <attribute name="type"/>
            </optional>
            <text/>
          </element>
          <ref name="desc"/>
          <ref name="ref"/>
        </choice>
      </zeroOrMore>
    </element>
  </define>

  <define name="desc">
    <element name="desc">
      <text/>
    </element>
  </define>

  <define name="profileDesc">
    <element name="profileDesc">
      <zeroOrMore>
        <element name="langUsage">
          <oneOrMore>
            <element name="language">
              <attribute name="ident">
                <a:documentation>BCP 47 language code.</a:documentation>
                <data type="language"/>
              </attribute>
              <optional>
                <attribute name="usage">
                  <data type="nonNegativeInteger"/>
                </attribute>
              </optional>
              <text/>
            </element>
          </oneOrMore>
        </element>
      </zeroOrMore>
    </element>
  </define>

  <define name="revisionDesc">
    <element name="revisionDesc">
      <zeroOrMore>
        <element name="change">
          <optional>
            <attribute name="status"/>
          </optional>
          <optional>
            <attribute name="when"/>
          </optional>
          <optional>
            <attribute name="who"/>
          </optional>
          <interleave>
            <text/>
            <zeroOrMore>
              <element name="note">
                <optional>
                  <attribute name="type"/>
                </optional>
                <text/>
              </element>
            </zeroOrMore>
            <zeroOrMore>
              <ref name="desc"/>
            </zeroOrMore>
          </interleave>
        </element>
      </zeroOrMore>
    </element>
  </define>

  <!-- ============================================================ -->
  <!-- Extracted references                                         -->
  <!-- ============================================================ -->

  <define name="standOff">
    <element name="standOff">
      <oneOrMore>
        <ref name="listBibl"/>
      </oneOrMore>
    </element>
  </define>

  <define name="listBibl">
    <element name="listBibl">
      <zeroOrMore>
        <ref name="biblStruct"/>
      </zeroOrMore>
    </element>
  </define>

  <define name="biblStruct">
    <element name="biblStruct">
      <a:documentation>A structured bibliographic reference.</a:documentation>
      <optional>
        <attribute name="source">
          <a:documentation>The footnote the reference was extracted from, e.g. "fn12".</a:documentation>
        </attribute>
      </optional>
      <optional>
        <attribute name="type">
          <choice>
            <group>
              <a:documentation>A statute / legislation citation</a:documentation>
              <value>legislation</value>
            </group>
            <group>
              <a:documentation>A court ruling / judicial decision citation</a:documentation>
              <value>decision</value>
            </group>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="status"/>
      </optional>
      <ref name="att.xmlid"/>
      <zeroOrMore>
        <ref name="analytic"/>
      </zeroOrMore>
      <oneOrMore>
        <ref name="monogr"/>
        <zeroOrMore>
          <ref name="series"/>
        </zeroOrMore>
      </oneOrMore>
      <zeroOrMore>
        <choice>
          <ref name="citedRange"/>
          <ref name="idno"/>
          <ref name="ptr"/>
          <ref name="ref"/>
          <ref name="note"/>
        </choice>
      </zeroOrMore>
    </element>
  </define>

  <define name="analytic">
    <element name="analytic">
      <a:documentation>The article, chapter or (for court rulings) the case.</a:documentation>
      <zeroOrMore>
        <choice>
          <ref name="title"/>
          <ref name="author"/>
          <ref name="editor"/>
          <ref name="date"/>
          <ref name="idno"/>
          <ref name="ptr"/>
        </choice>
      </zeroOrMore>
    </element>
  </define>

  <define name="monogr">
    <element name="monogr">
      <a:documentation>The book, journal, statute or reporter.</a:documentation>
      <zeroOrMore>
        <choice>
          <ref name="title"/>
          <ref name="author"/>
          <ref name="editor"/>
          <ref name="authority"/>
          <ref name="edition"/>
          <ref name="imprint"/>
          <ref name="biblScope"/>
          <ref name="date"/>
          <ref name="idno"/>
          <ref name="ptr"/>
          <ref name="note"/>
        </choice>
      </zeroOrMore>
    </element>
  </define>

  <define name="series">
    <element name="series">
      <zeroOrMore>
        <choice>
          <ref name="title"/>
          <ref name="editor"/>
          <ref name="biblScope"/>
          <ref name="idno"/>
        </choice>
      </zeroOrMore>
    </element>
  </define>

  <define name="imprint">
    <element name="imprint">
      <zeroOrMore>
        <choice>
          <ref name="publisher"/>
          <ref name="pubPlace"/>
          <ref name="date"/>
          <ref name="biblScope"/>
        </choice>
      </zeroOrMore>
    </element>
  </define>

  <!-- ============================================================ -->
  <!-- Titles                                                       -->
  <!-- ============================================================ -->

  <!-- Inline <authority>, <date>, <idno> and <ref> may be tagged where the
       source text embeds them in a formal title (e.g. an act's number). -->
  <define name="title">
    <element name="title">
      <optional>
        <attribute name="level">
          <choice>
            <group>
              <a:documentation>Article, chapter or case name</a:documentation>
              <value>a</value>
            </group>
            <group>
              <a:documentation>Monograph, edited volume, statute</a:documentation>
              <value>m</value>
            </group>
            <group>
              <a:documentation>Journal</a:documentation>
              <value>j</value>
            </group>
            <group>
              <a:documentation>Series</a:documentation>
              <value>s</value>
            </group>
            <group>
              <a:documentation>Unpublished work</a:documentation>
              <value>u</value>
            </group>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="type">
          <choice>
            <group>
              <a:documentation>Title of a statute / legislative act (with level="m")</a:documentation>
              <value>legislation</value>
            </group>
            <group>
              <a:documentation>Case name of a court ruling (with level="a")</a:documentation>
              <value>caseName</value>
            </group>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="subtype">
          <a:documentation>Abbreviated form of a title given in full elsewhere.</a:documentation>
          <value>short</value>
        </attribute>
      </optional>
      <optional>
        <attribute name="key">
          <a:documentation>Short resolvable key for a named work, e.g. key="UrhG".</a:documentation>
        </attribute>
      </optional>
      <interleave>
        <text/>
        <zeroOrMore>
          <choice>
            <ref name="authority"/>
            <ref name="date"/>
            <ref name="idno"/>
            <ref name="ref"/>
          </choice>
        </zeroOrMore>
      </interleave>
    </element>
  </define>

  <define name="edition">
    <element name="edition">
      <optional>
        <attribute name="n"/>
      </optional>
      <text/>
    </element>
  </define>

  <!-- ============================================================ -->
  <!-- Persons and organizations                                    -->
  <!-- ============================================================ -->

  <define name="author">
    <element name="author">
      <ref name="responsibility"/>
    </element>
  </define>

  <define name="editor">
    <element name="editor">
      <optional>
        <attribute name="role">
          <value>translator</value>
        </attribute>
      </optional>
      <ref name="responsibility"/>
    </element>
  </define>

  <define name="responsibility">
    <ref name="att.xmlid"/>
    <zeroOrMore>
      <choice>
        <ref name="persName"/>
        <ref name="orgName"/>
      </choice>
    </zeroOrMore>
  </define>

  <define name="persName">
    <element name="persName">
      <ref name="att.xmlid"/>
      <zeroOrMore>
        <choice>
          <element name="forename">
            <optional>
              <attribute name="type">
                <choice>
                  <value>first</value>
                  <value>middle</value>
                </choice>
              </attribute>
            </optional>
            <text/>
          </element>
          <element name="surname"><text/></element>
          <element name="nameLink"><text/></element>
          <element name="roleName"><text/></element>
        </choice>
      </zeroOrMore>
    </element>
  </define>

  <define name="orgName">
    <element name="orgName">
      <optional>
        <attribute name="type">
          <choice>
            <value>institution</value>
            <value>collaboration</value>
            <value>department</value>
            <value>laboratory</value>
            <value>jurisdiction</value>
          </choice>
        </attribute>
      </optional>
      <text/>
    </element>
  </define>

  <define name="authority">
    <element name="authority">
      <a:documentation>Institution responsible for the cited work (court, legislature, regulator).</a:documentation>
      <optional>
        <attribute name="type">
          <choice>
            <value>court</value>
            <value>legislature</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="key"/>
      </optional>
      <interleave>
        <text/>
        <zeroOrMore>
          <ref name="orgName"/>
        </zeroOrMore>
      </interleave>
    </element>
  </define>

  <!-- ============================================================ -->
  <!-- Imprint, scopes, dates, identifiers                          -->
  <!-- ============================================================ -->

  <define name="publisher">
    <element name="publisher">
      <text/>
    </element>
  </define>

  <define name="pubPlace">
    <element name="pubPlace">
      <text/>
    </element>
  </define>

  <define name="date">
    <element name="date">
      <optional>
        <attribute name="type">
          <choice>
            <value>publication</value>
            <group>
              <a:documentation>Date a court decision was issued</a:documentation>
              <value>decision</value>
            </group>
            <group>
              <a:documentation>Date a statute was enacted</a:documentation>
              <value>enacted</value>
            </group>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="when"/>
      </optional>
      <text/>
    </element>
  </define>

  <define name="biblScope">
    <element name="biblScope">
      <a:documentation>Volume, issue or page extent of the containing work.</a:documentation>
      <optional>
        <attribute name="unit">
          <choice>
            <value>volume</value>
            <value>issue</value>
            <value>page</value>
          </choice>
        </attribute>
      </optional>
      <ref name="att.fromTo"/>
      <text/>
    </element>
  </define>

  <define name="citedRange">
    <element name="citedRange">
      <a:documentation>Pinpoint into the cited work (page, section, marginal number, etc.).</a:documentation>
      <optional>
        <attribute name="unit">
          <choice>
            <value>page</value>
            <value>section</value>
            <value>subSection</value>
            <value>sentence</value>
            <value>number</value>
            <value>letter</value>
            <group>
              <a:documentation>Marginal number, e.g. Rn./Tz. 12</a:documentation>
              <value>margin</value>
            </group>
            <group>
              <a:documentation>Recital of an EU legal act</a:documentation>
              <value>recital</value>
            </group>
          </choice>
        </attribute>
      </optional>
      <ref name="att.fromTo"/>
      <text/>
    </element>
  </define>

  <define name="att.fromTo">
    <optional>
      <attribute name="from"/>
    </optional>
    <optional>
      <attribute name="to"/>
    </optional>
  </define>

  <define name="idno">
    <element name="idno">
      <optional>
        <attribute name="type">
          <choice>
            <value>DOI</value>
            <value>ISSN</value>
            <value>arXiv</value>
            <value>report</value>
            <value>docket</value>
            <value>ECLI</value>
            <value>CELEX</value>
            <value>actNumber</value>
          </choice>
        </attribute>
      </optional>
      <text/>
    </element>
  </define>

  <define name="ptr">
    <element name="ptr">
      <optional>
        <attribute name="type">
          <value>web</value>
        </attribute>
      </optional>
      <attribute name="target"/>
      <empty/>
    </element>
  </define>

  <define name="note">
    <element name="note">
      <optional>
        <attribute name="type">
          <a:documentation>"report": type of report or thesis (e.g. 'Ph.D. thesis').</a:documentation>
          <value>report</value>
        </attribute>
      </optional>
      <text/>
    </element>
  </define>

  <!-- In references: anaphoric devices ("ibid.", "a.a.O.", "ders.", "supra")
       and footnote cross-references. In the header: links to
       instructions, applications and schemas. -->
  <define name="ref">
    <element name="ref">
      <optional>
        <attribute name="type"/>
      </optional>
      <optional>
        <attribute name="subtype"/>
      </optional>
      <optional>
        <attribute name="n"/>
      </optional>
      <optional>
        <attribute name="target"/>
      </optional>
      <text/>
    </element>
  </define>

</grammar>
